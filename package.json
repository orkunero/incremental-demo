{
  "name": "git-rich",
  "private": true,
  "version": "0.8.0",
  "description": "An incremental game about growing a software company, played inside an IDE.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "node tools/sim.ts",
    "balance": "node tools/balance.ts",
    "check": "npm run typecheck && npm run test && npm run balance && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
